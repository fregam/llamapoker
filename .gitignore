node_modules
dist
*.local
dist-ssr

# Local secrets: never commit
credentials.json
.env
.env.*

# Brand build intermediates (apps/web/scripts/brand-assets.mjs)
brand/.build/

# Media binaries live in media/ (same tree as content/), not in git.
# Tracked instead: media/README.md and the manifests in content/ (sha256, source, prompt per file).
media/*
!media/README.md

# Claude Code worktrees (agents working on other branches)
.claude/worktrees/
__pycache__/

# job logs (apps/wall/scripts/job.mjs), cleared after 14 days
logs/

# Hook corpus store (apps/reels/scripts/hooks/corpus.py), research data, never committed
apps/reels/scripts/hooks/data/

# Copy research store and downloads (apps/copy/store.py): NC-licensed data, never committed
apps/copy/data/
