  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#2a6f85", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"], "settings": { "foreground": "#6fe3ff" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#49a9c4" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#e6fbff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace"], "settings": { "foreground": "#49a9c4" } },
    { "scope": ["variable", "meta.definition.variable", "variable.other.readwrite"], "settings": { "foreground": "#9fdcec" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#b8eefc", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name", "entity.other.attribute-name"], "settings": { "foreground": "#7cc6d9" } },
    { "scope": ["string", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#a8f0ff" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant", "variable.other.constant"], "settings": { "foreground": "#ff8a1f" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#ffb070" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#6fe3ff" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#6fe3ff", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold", "foreground": "#e6fbff" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#a8f0ff" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#49a9c4" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6fe3ff" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#ff8a1f" } },
    { "scope": ["markup.deleted", "invalid", "invalid.illegal"], "settings": { "foreground": "#ff4d4d" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#ff8a1f", "fontStyle": "strikethrough" } }
  ]
}
